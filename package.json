    "test:assistant-endpoint": "node --no-warnings --import ./scripts/lib/ts-resolve.mjs scripts/test-assistant-endpoint.mjs",
    "eval:assistant": "node --no-warnings --import ./scripts/lib/ts-resolve.mjs scripts/assistant-eval-live.mjs"
